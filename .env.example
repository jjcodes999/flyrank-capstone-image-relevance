# Copy to .env and change the password. .env is gitignored; never commit it.

# --- database (Postgres + pgvector in docker compose) ---
POSTGRES_USER=imagematch
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=imagematch
# host-side ports (inside compose the api/worker use db:5432)
DB_HOST_PORT=5433
API_HOST_PORT=8000
# only for running the app outside docker (tests, scripts from a venv)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- local AI via Ollama (free, no key) ---
# OLLAMA_BASE_URL is for scripts run on the host; containers use OLLAMA_DOCKER_URL
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DOCKER_URL=http://host.docker.internal:11434
VISION_MODEL=qwen3-vl:4b
EMBED_MODEL=all-minilm
EMBED_DIM=384
OLLAMA_TIMEOUT_S=1800
# context window per call; the model's hidden reasoning must fit in it
OLLAMA_NUM_CTX=8192
VISION_MAX_SIDE=512
VISION_MAX_RETRIES=2

IMAGES_DIR=data/images

# --- low-confidence flag ---
MIN_CONFIDENCE=0.60
BLUR_THRESHOLD=15

# --- mismatch guard ---
SIMILARITY_THRESHOLD=0.45
SUBJECT_SIM_THRESHOLD=0.80

# --- background jobs ---
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_BASE_S=2
JOB_POLL_INTERVAL_S=2
JOB_STALE_AFTER_S=2400

# --- cost tracking / budget guard ---
# actual cost is $0 (local); notional rates price tokens as if sent to a hosted API
NOTIONAL_USD_PER_1M_INPUT_TOKENS=0.10
NOTIONAL_USD_PER_1M_OUTPUT_TOKENS=0.40
NOTIONAL_USD_PER_1M_EMBED_TOKENS=0.02
AI_BUDGET_USD=1.00
AI_MAX_CALLS_PER_JOB=500

DEFAULT_TENANT=demo
LOG_LEVEL=INFO
